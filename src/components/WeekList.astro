---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { findTeachingBreak, formatCourseDate, formatCourseDateRange } from "../lib/dates";

interface Props {
  /** Which dated weekly collection to list. */
  collection: "lectures" | "sessions";
  /** Heading level for each row's title, so the page outline stays correct. */
  headingLevel?: "h2" | "h3";
}

const { collection, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;

const entries = (await getPublishedCollection(collection)).sort(
  (a, b) => a.data.week - b.data.week,
);

// Same derivation as the semester overview: the break is whatever gap the
// dated weeks leave, never a separately maintained fact.
const teachingBreak = findTeachingBreak(
  entries.map((entry) => ({ week: entry.data.week, date: entry.data.date })),
);
---

<ul class="week-list">
  {
    entries.map((entry) => (
      <>
        {teachingBreak && entry.data.week === teachingBreak.beforeWeek && (
          <li class="week-break">
            <span class="week-break-label">Teaching break</span>
            <span class="week-break-detail">
              {formatCourseDateRange(teachingBreak.start, teachingBreak.end)} — no lecture or
              tutorial.
            </span>
          </li>
        )}
        <li class="week-row">
          <div class="week-meta">
            <span class="week-number">Week {entry.data.week}</span>
            <span class="week-date">{formatCourseDate(entry.data.date)}</span>
          </div>
          <div class="week-body">
            <Heading class="week-title">
              <a href={withBase(`/${collection}/${entry.id}/`)}>{entry.data.title}</a>
            </Heading>
            {entry.data.description && <p class="week-description">{entry.data.description}</p>}
          </div>
        </li>
      </>
    ))
  }
</ul>

<style>
  .week-list {
    list-style: none;
    margin: var(--at-spacing-lg) 0;
    padding: 0;
    border-top: 1px solid var(--at-border);
  }

  .week-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(8rem, 10rem) 1fr;
    gap: var(--at-spacing-md);
    padding: var(--at-spacing-md) 0;
    border-bottom: 1px solid var(--at-border);
  }

  .week-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .week-number {
    color: var(--at-accent);
    font-weight: 600;
    line-height: var(--at-line-height-heading);
  }

  .week-date {
    color: var(--at-text-muted);
    font-size: var(--at-font-size-sm);
  }

  .week-body > :global(*) {
    margin: 0;
  }

  .week-title {
    font-size: var(--at-font-size-h4);
  }

  /* The theme colours both headings and links gold. Here that would put two
     near-identical golds side by side in every row, so the accent is spent
     once — on the week label — and the title carries the body text colour. */
  .week-title :global(a) {
    color: var(--at-text);
    text-decoration: none;
  }

  /* The whole row is the target: the link keeps its own accessible name and
     stays the single tab stop, while its overlay covers the row. */
  .week-title :global(a)::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .week-description {
    margin-top: 0.35rem;
    color: var(--at-text-secondary);
  }

  .week-row:hover .week-title :global(a),
  .week-row:focus-within .week-title :global(a) {
    color: var(--at-accent);
    text-decoration: underline;
  }

  .week-row:focus-within {
    outline: 2px solid var(--at-accent);
    outline-offset: 2px;
  }

  .week-title :global(a):focus-visible {
    outline: none;
  }

  /* Matches the teaching-break row in the semester overview table. */
  .week-break {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5ch;
    padding: var(--at-spacing-sm) var(--at-spacing-md);
    border-bottom: 1px solid var(--at-border);
    background: var(--at-bg-alt);
    font-style: italic;
    font-size: var(--at-font-size-sm);
  }

  .week-break-label {
    font-weight: 600;
  }

  .week-break-detail {
    color: var(--at-text-secondary);
  }

  @media (max-width: 34rem) {
    .week-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .week-meta {
      flex-direction: row;
      align-items: baseline;
      gap: 0.6ch;
    }

    .week-date::before {
      content: "· ";
    }
  }
</style>
