---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.svg";
import { courseMeta } from "../course-config";
import { findTeachingBreak, spellCount } from "../lib/dates";
import { sessionLabels, siteConfig } from "../site-config";

// Derived from the sessions' own dates rather than written out, so this
// sentence cannot fall out of step with the semester overview table.
const sessions = await getPublishedCollection("sessions");
const teachingBreak = findTeachingBreak(
  sessions.map((session) => ({ week: session.data.week, date: session.data.date })),
);
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A risograph-style illustration on cream paper: the back of a mailing envelope, its wide triangular flap printed in solid gold with a plain gold wax seal poured over the apex, and a quick estimate scrawled across the panel below — three small boxes joined by plus signs, a wavy approximately sign, then a short range bar with a gold dot marking the figure landed on"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Alongside a semester-long calibration diary — ranges committed before you
    know the answer — each week gives you a different way estimates go
    wrong: decomposition, borrowed evidence, disagreement, pressure,
    aggregation, stakes, forecasting. You decompose real quantities into
    chains of assumptions, give each one a stated range, and defend it when
    someone leans on it. The two pieces of graded work are the diary itself
    and one real, contested estimate, cross-examined in front of the class.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone who has to give a number to someone who will act on it, without
    time to run a full study first — the course teaches judgment under
    incomplete evidence, not formulas.
  </p>

  <h2>How the course runs</h2>
  <p>
    Each teaching week runs one lecture, delivered by the course convenor,
    and one tutorial per student, chosen from four weekly timeslots — all
    four cover the same session content, taught by one of three tutors.
    {
      teachingBreak && (
        <>
          {" "}
          There is a {spellCount(teachingBreak.weeks)}-week teaching break
          between Weeks {teachingBreak.afterWeek} and {teachingBreak.beforeWeek}
          , with no lecture or tutorial in either of those weeks.{" "}
        </>
      )
    }
    Full times, tutors and the semester overview are on the {
      sessionLabels.plural
    } page.
  </p>

  <h2>Assessment</h2>
  <p>Two pieces of work, no final examination:</p>
  <ul>
    <li><strong>Calibration Diary</strong> — 45%</li>
    <li><strong>Client Estimate &amp; Estimate Court</strong> — 55%</li>
  </ul>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Lectures" href="/lectures/">
      <p>What each week's lecture covers, and when.</p>
    </Card>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly tutorial timetable and what happens in each session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style is:global>
  /* Home only. The theme's hero scrim fades bottom-up across the full width,
     which suits a photograph but flattens this hero's cream paper into grey
     and mutes the gold. The art here is deliberately right-weighted, so the
     scrim is re-aimed left-to-right instead: dark enough under the title
     block at every viewport width, near-clear over the drawing's showcase
     half. Unlayered, so it beats the theme's `@layer at.components` rule
     without a theme edit; scoped to this route, so /404 and the People pages
     keep the stock bottom-up treatment.

     The vertical pass is deliberately loose through the middle (44% at 52%)
     and heavy only at the very bottom, where the title's baseline sits. That
     is what keeps the envelope's card face warm rather than grey: the card
     sits in the mid-band, and `cover` pushes it lower into the scrim as the
     viewport narrows, so 1920px is the worst case for contrast, not 2560.
     Measured there at 5.3:1 against white, on a 4.5:1 floor -- a looser pass
     (40% at 50%) reached 4.6:1, which cleared the floor but left only 3% of
     margin against font and line-box variation. Loosening the horizontal pass
     instead was tried and rejected: the card face sits at 76-86% across,
     where that layer is already near zero, so easing it bought 0.004
     luminance and cost 0.4 of contrast margin. */
  .at-hero .at-hero-content {
    background:
      linear-gradient(
        100deg,
        rgb(0 0 0 / 60%) 0%,
        rgb(0 0 0 / 48%) 34%,
        rgb(0 0 0 / 14%) 62%,
        rgb(0 0 0 / 0%) 82%
      ),
      linear-gradient(
        to top,
        rgb(0 0 0 / 80%) 0%,
        rgb(0 0 0 / 44%) 52%,
        rgb(0 0 0 / 3%) 82%
      );
  }
</style>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
